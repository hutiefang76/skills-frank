# 默认行尾
* text=auto eol=lf

# Windows 专属脚本必须 CRLF (cmd 解析需要)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix 脚本 LF
*.sh text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# 二进制不做转换
*.png binary
*.jpg binary
*.ico binary
