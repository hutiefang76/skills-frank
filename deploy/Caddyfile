# frank-stack Caddy 反代
#
# 单一对外端口 :8317; 全部用 TLS (Caddy 自签内部 CA, 浏览器会警告 — 后续上域名 + LE).
#
# 路由:
#   /qdrant/healthz, /qdrant/*  → qdrant:6333 (HTTP API + 管理界面; 调试用)
#   /memory/*, /orchestrator/*  → sync-agent:3000 (待 frank-sync-agent 上线)
#   /healthz                    → Caddy 自身 200, 用于外部存活探针
#   /                           → 临时 placeholder (后续放 orchestrator web SPA)
#
# 安全:
#   - admin UI 通过 X-Frank-Token header 鉴权 (在腾讯云控制台单独白名单更稳)
#   - 后续接入 OAuth / mTLS

{
  # 全局选项
  auto_https off       # 端口非 443, 不让 Caddy 抢系统证书; 用 tls internal
  admin off            # 关闭本地 admin API (默认开 :2019), 减少攻击面
  log {
    output stdout
    format json
    level INFO
  }
}

http://frank.hutiefang.com:8318, http://101.35.227.232:8318, :8317 {
  # 三种访问入口都接:
  #   1. http://frank.hutiefang.com:8318 (推荐, 需 DNS A 记录指向 101.35.227.232)
  #   2. http://101.35.227.232:8318 (IP fallback)
  #   3. 容器内 :8317 (健康探针)
  #
  # HTTPS: 8318 走 LE/ZeroSSL 需要 ACME challenge, 与现有 80/443 (1Panel) 冲突.
  # 后续要 HTTPS 改走 1Panel 加 frank.hutiefang.com 的 443 反代 → http://tx:8318

  encode gzip zstd

  # 健康探针 (本机 / Tencent CLB 用), 不鉴权
  respond /healthz "ok" 200

  # ─── 鉴权策略 ─────────────────────────────────────────────────────────
  # /memory/* 与 /orchestrator/* 包含读/写/删, 公网暴露必须鉴权; 仅 healthz 例外.
  # token 注入: docker-compose 把 FRANK_API_TOKEN 通过 env 传给 Caddy 容器, Caddyfile
  # 在加载时用 {$FRANK_API_TOKEN} 占位符内插. 容器外用 /opt/frank/.secrets/api_token 持久化.

  @memory_healthz path /memory/healthz
  @sync_protected {
    path /memory/* /orchestrator/*
    not path /memory/healthz
  }

  # healthz 直放 (探活, 公网友好)
  handle @memory_healthz {
    reverse_proxy sync-agent:3000
  }

  # 受保护路由: 必须带 X-Frank-Token, 否则 401
  handle @sync_protected {
    @authorized header X-Frank-Token "{$FRANK_API_TOKEN}"
    handle @authorized {
      reverse_proxy sync-agent:3000
    }
    respond "missing or invalid X-Frank-Token header" 401
  }

  # Qdrant 管理 / API (Path strip: /qdrant/foo → /foo). 同样要 token (含数据库写权限!)
  handle /qdrant/* {
    @qdrant_authorized header X-Frank-Token "{$FRANK_API_TOKEN}"
    handle @qdrant_authorized {
      handle_path /qdrant/* {
        reverse_proxy qdrant:6333
      }
    }
    respond "missing or invalid X-Frank-Token header" 401
  }

  # 默认 placeholder (后续放 orchestrator web SPA)
  respond / "frank-stack alive. routes: /healthz /qdrant/* /memory/* /orchestrator/*" 200

  log {
    output stdout
    format console
  }
}
